{
  "name": "personalized-learning-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tailwind": "tailwindcss -i src/assets/styles/_tailwind.src.css -o src/assets/styles/_tailwind.css --config tailwind.config.js",
    "tailwind:watch": "tailwindcss -i src/assets/styles/_tailwind.src.css -o src/assets/styles/_tailwind.css --config tailwind.config.js --watch",
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run tailwind && vite",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "test": "node --test --test-concurrency=4",
    "test:navigation": "node --test src/navigation-cleanup.test.mjs",
    "test:chat-api": "node --test server/chat-api.test.mjs",
    "experiment:anomaly": "node experiments/run-anomaly-tests.mjs",
    "experiment:baseline": "node experiments/capture-baseline.mjs",
    "experiment:learning-cycle": "node experiments/run-learning-cycle-cases.mjs",
    "experiment:rag-contest": "node experiments/run-rag-contest.mjs",
    "experiment:deepseek-contest": "node experiments/run-deepseek-contest.mjs",
    "build": "npm run tailwind && vue-tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview",
    "build:mobile": "vue-tsc --noEmit && node scripts/build-mobile.mjs",
    "android:build": "node scripts/android-build.mjs",
    "cap:sync": "npx cap sync android",
    "test:mobile-e2e": "node scripts/mobile-e2e.mjs",
    "test:mobile-e2e-data": "node scripts/mobile-e2e-data.mjs",
    "test:mobile-e2e-study": "node scripts/mobile-e2e-study.mjs",
    "test:evaluation-browser": "node scripts/evaluation-browser-smoke.mjs",
    "verify:mysql": "node scripts/verify-mysql.mjs",
    "postinstall": "node scripts/patch-secure-storage.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@dgreenheck/ez-tree": "file:vendor/dgreenheck-ez-tree-1.1.0.tgz",
    "@lucide/vue": "^1.16.0",
    "@pixi/app": "^6.5.10",
    "@pixi/constants": "^6.5.10",
    "@pixi/core": "^6.5.10",
    "@pixi/display": "^6.5.10",
    "@pixi/extensions": "^6.5.10",
    "@pixi/interaction": "^6.5.10",
    "@pixi/loaders": "^6.5.10",
    "@pixi/math": "^6.5.10",
    "@pixi/runner": "^6.5.10",
    "@pixi/settings": "^6.5.10",
    "@pixi/sprite": "^6.5.10",
    "@pixi/ticker": "^6.5.10",
    "@pixi/utils": "^6.5.10",
    "@vueuse/motion": "^2.2.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "mysql2": "^3.22.6",
    "pinia": "^2.1.7",
    "pixi-live2d-display": "^0.4.0",
    "three": "^0.184.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.2",
    "vite": "^6.4.2",
    "vue-tsc": "^2.2.12"
  }
}
