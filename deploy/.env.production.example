# Copy to the project root .env and fill locally. Never commit populated values.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8255
MYSQL_DATABASE=edumind
MYSQL_USER=edumind_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_POOL_SIZE=10
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
CORS_ALLOWED_ORIGINS=

# Leave sales disabled until delivery, account/entitlement enforcement,
# official product activation, HTTPS notifications and production testing pass.
EDUMIND_PAYMENT_ENABLED=false
EDUMIND_PAYMENT_PRICE_CENTS=
PAYMENT_BASE_URL=
VIBE_PAY_APP_ID=
VIBE_PAY_SELLER_ID=
VIBE_PAY_PRIVATE_KEY=
VIBE_PAY_ALIPAY_PUBLIC_KEY=
