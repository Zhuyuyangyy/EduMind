# 复制本文件为 .env 后填入真实值：cp .env.example .env
# 注意：本文件只包含占位符，请勿提交真实密钥。

# 后端 API 端口（server/index.js 读取 PORT，默认 8788）
PORT=8788

APP_PORT=8255

# 评审演示账号（管理员账号默认关闭；如需启用请在本地 .env 中配置）
# 学生端提供两组等效账号，任一均可登录；可用 *_ALT 覆盖第二组
DEMO_STUDENT_ACCOUNT=reviewer
DEMO_STUDENT_PASSWORD=Zhixue2026!
DEMO_STUDENT_ACCOUNT_ALT=student
DEMO_STUDENT_PASSWORD_ALT=student123
DEMO_ADMIN_ACCOUNT=
DEMO_ADMIN_PASSWORD=
# 仅显式演示构建显示/预填公开演示账号；生产构建保持 false
VITE_DEMO_MODE=false

# —— MySQL ——
MYSQL_DATABASE=edumind
MYSQL_USER=edumind_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_POOL_SIZE=10

# —— LLM（RAG / Agent 链路真实调用依赖此项，缺失时服务会退化为内置兜底数据）——
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=replace-with-your-server-side-api-key
LLM_MODEL=deepseek-chat

# —— 会话（P0 认证改造 · feat/mobile-v1）——
# 会话有效期（小时），默认 168（7 天）。会话为服务端内存存储，重启后需重新登录。
SESSION_TTL_HOURS=168
# Cookie 的 SameSite 策略。Capacitor iOS（capacitor://localhost）需要 None，并必须同时设置 SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
# 生产模式由服务端强制 Secure；本地 http 开发可保持 false
SESSION_COOKIE_SECURE=true
# 仅测试脚本可显式允许生产模式使用 JSON；正式部署不要设置
ZHIXUE_ALLOW_JSON_PRODUCTION=0
# CORS 白名单（逗号分隔）。留空时使用内置默认值（本地开发 + Capacitor 来源）。
# 生产部署建议显式指定，例如：https://yx.shushubiye.fun
CORS_ALLOWED_ORIGINS=
