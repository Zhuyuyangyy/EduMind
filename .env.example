# 复制本文件为 .env 后填入真实值：cp .env.example .env
# 注意：本文件只包含占位符，请勿提交真实密钥。

# 后端 API 端口（server/index.js 读取 PORT，默认 8788）
PORT=8788

APP_PORT=8255

# 评审演示账号（管理员账号默认关闭；如需启用请在本地 .env 中配置）
# 学生端提供两组等效账号，任一均可登录；可用 *_ALT 覆盖第二组
DEMO_STUDENT_ACCOUNT=reviewer
DEMO_STUDENT_PASSWORD=Zhixue2026!
DEMO_STUDENT_ACCOUNT_ALT=student
DEMO_STUDENT_PASSWORD_ALT=student123
DEMO_ADMIN_ACCOUNT=
DEMO_ADMIN_PASSWORD=

# —— MySQL ——
MYSQL_DATABASE=edumind
MYSQL_USER=edumind_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_POOL_SIZE=10

# —— LLM（RAG / Agent 链路真实调用依赖此项，缺失时服务会退化为内置兜底数据）——
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=replace-with-your-server-side-api-key
LLM_MODEL=deepseek-chat
